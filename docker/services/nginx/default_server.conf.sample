server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;   # tu i tak nie ma znaczenia, bo to default_server

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_min_length 256;

    root /var/www/html;

    location ^~ /api/ {
        # Allow only standard HTTP methods
        if ($request_method !~ ^(GET|POST|PUT|DELETE|OPTIONS)$) {
            return 405;
        }

        # Proxy headers
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";  # Required for websockets
        proxy_set_header X-Request-Id $request_id;

        # Backend service
        proxy_pass http://webserver:8080/;  # Use Docker service name

        proxy_redirect off;

        # Timeouts
        proxy_read_timeout    900s;
        proxy_send_timeout    300s;
        send_timeout          300s;
        proxy_connect_timeout 2s;

        # Buffers
        proxy_buffer_size     256k;
        proxy_buffers         8 512k;
        proxy_busy_buffers_size 512k;
    }

    # RabbitMQ Management UI
    location = /rabbitmq {
        return 301 /rabbitmq/;
    }

    location ^~ /rabbitmq/ {
        # Allow only standard HTTP methods
        if ($request_method !~ ^(GET|POST|PUT|DELETE|OPTIONS)$) {
            return 405;
        }

        # Proxy headers
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";  # Required for websockets
        proxy_set_header X-Request-Id $request_id;

        # RabbitMQ service
        proxy_pass http://rabbitmq:15672/;
        proxy_redirect ~^/(.*) /rabbitmq/$1;

        # Timeouts
        proxy_read_timeout    900s;
        proxy_connect_timeout 60s;
        proxy_send_timeout    300s;
        send_timeout          300s;

        # Buffers
        proxy_buffer_size     256k;
        proxy_buffers         8 512k;
        proxy_busy_buffers_size 512k;
    }

    location / {
        # Allow only standard HTTP methods
        if ($request_method !~ ^(GET|POST|PUT|DELETE|OPTIONS)$) {
            return 405;
        }

        # Proxy headers
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";  # Required for websockets
        proxy_set_header X-Request-Id $request_id;

        # Frontend Vite dev server
        proxy_pass http://host.docker.internal:{VITE_PORT};

        proxy_redirect off;

        # Timeouts
        proxy_read_timeout    900s;
        proxy_send_timeout    300s;
        send_timeout          300s;
        proxy_connect_timeout 2s;

        # Buffers
        proxy_buffer_size     256k;
        proxy_buffers         8 512k;
        proxy_busy_buffers_size 512k;
    }

    access_log /var/log/nginx/access_default.log main;
    error_log /var/log/nginx/error_default.log;
}
